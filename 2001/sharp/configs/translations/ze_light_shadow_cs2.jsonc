  "*** admin set stage shadow ***": {
    "translation": "管理员将关卡设置为暗影"
  },
  "*** admin slay all ***": {
    "translation": "管理员处决了所有玩家"
  },
  "*** admin skip stage ring ***": {
    "translation": "管理员调整关卡为光环"
  },
  "*** admin skip stage core ***": {
    "translation": "管理员跳转至核心关"
  },
  "*** admin set stage escape ***": {
    "translation": "管理员将关卡设置为逃亡"
  },
  "*** admin reset stage ***": {
    "translation": "管理员重置了关卡"
  },
  "*** stage set to Ring ***": {
    "translation": "当前关卡:光环"
  },
  "*** stage set to Core ***": {
    "translation": "当前关卡:核心"
  },
  "*** stage set to Escape ***": {
    "translation": "当前关卡:逃离"
  },
  "*** stage set to Shadow ***": {
    "translation": "当前关卡:暗影"
  },
