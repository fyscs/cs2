  // 可用字段:
  // [Boss (Breakables/Counters)]
  // display    (string)   -> 显示的名称
  // hitbox     (string)   -> 打击框
  // stages     (int)      -> 阶段数
  // target     (string)   -> 目标名称 (Breakable only)
  // iterator   (string)   -> 计数器 (MathCounter only)
  // backup     (string)   -> 后备计数器 (MathCounter only)
  // mass       (int)      -> 后备算法参数 (MathCounter only)
  // counter    (string)   -> 血条计数器 (MathCounter only)
  // increase   (bool)     -> iterator是OnHitMax模式 (MathCounter only) 
  // reverse    (bool)     -> counter是OnHitMax模式 (MathCounter only)
  // [Npc (Monsters)]
  // display    (string)   -> 显示的名称
  // identity   (string)   -> UniqueHammerId (同时支持Counter/Breakable)

{
  "Counters": [
    {
      "iterator": "Fat_Nigger_Counter",
      "hitbox": "Fat_Nigger_Phys",
      "display": "骷髅守卫"
    },
    {
      "iterator": "Stage_4_End_Guard_Counter",
      "hitbox": "Stage_4_End_Guard_Phys",
      "display": "加布拉斯"
    },
    // 三只召唤兽共用血量计数器, 不固定绑定其中一只的打击框.
    {
      "iterator": "Special_Health",
      "backup": "Special_HealthInit",
      "counter": "Special_HealthCount",
      "reverse": true,
      "display": "召唤兽"
    },
    {
      "iterator": "Stage_2_End_Dragon_Counter",
      "hitbox": "Stage_2_End_Boss_Phys",
      "display": "海德拉"
    },
    {
      "iterator": "Stage_3_End_Boss_Counter",
      "hitbox": "Stage_3_End_Boss_Phys",
      "display": "海德拉"
    },
    {
      "iterator": "Stage_24_End_Famfrit_Counter",
      "hitbox": "Stage_24_End_Famfrit_Phys",
      "display": "法姆弗里特"
    }
  ],
  "Monsters": [
    {
      // 两个召唤物打击框共用此计数器, 物理盒自身血量不是实际血量.
      "identity": "2738",
      "display": "希德博士"
    }
  ]
