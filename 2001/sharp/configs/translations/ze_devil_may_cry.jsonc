  ">Dante: Come on baby,come get me!": {
    "translation": ">Dante: 来吧宝贝,快来抓我!"
  },
  "> ACT III CLEARED <": {
    "translation": "> 第三幕完结 <"
  },
  ">Angelo: It's not done yet,Spartans.": {
    "translation": ">Angelo: 还没完呢,斯巴达们."
  },
  ">Angelo: We will meet again soon.": {
    "translation": ">Angelo: 我们很快会再见面."
  },
  "< Seems like entrance has sealed. >": {
    "translation": "< 看起来入口已经封死了. >"
